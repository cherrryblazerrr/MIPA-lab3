        <calculation class='tableau' formula='COUNTD(IF [Calculation_1620470231498758] THEN [user_id (payments.csv)] END)' />
      </column>
      <column caption='ARPPU' datatype='real' name='[Calculation_1620470233661453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1620470233296907] / [Calculation_1620470233505804]' />
